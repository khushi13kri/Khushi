# Copy this file to .env and fill in your Supabase project's values.
# Find both under: Supabase Dashboard -> your project -> Settings -> API.
#
# The EXPO_PUBLIC_ prefix means these are bundled into the client app.
# That's expected for Supabase's anon key — it's designed to be public;
# access control comes from the Row Level Security policies in
# supabase/migrations/, not from hiding this key. Never put a service
# role key or any other secret behind EXPO_PUBLIC_.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
